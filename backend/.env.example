# BioTwin Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (optional - falls back to in-memory MockDB if not set)
MONGODB_URI=mongodb://localhost:27017/biotwin

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-min-32-chars-here
JWT_EXPIRES_IN=24h

# External API Keys (for HMS/EHR integration)
HMS_API_KEY=your-hms-api-key-here
EHR_API_KEY=your-ehr-api-key-here

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
